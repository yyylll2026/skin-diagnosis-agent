# =============================================================
# 皮肤诊断智能体 - 后端配置模板
# 复制为 .env 后按需修改。所有变量均带 SKIN_ 前缀。
# =============================================================

# ---------- 应用 ----------
SKIN_APP_NAME=Skin Diagnosis Agent
SKIN_DEBUG=false
SKIN_API_PREFIX=/api/v1
# 逗号分隔；生产环境请收敛为真实前端域名
SKIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 模型后端 ----------
# ollama | cloud
#   ollama -> 本地推理（需能访问 ollama serve）
#   cloud  -> OpenAI 兼容云端 API（阿里云百炼等）；小内存免费 PaaS 用 cloud
SKIN_LLM_BACKEND=ollama
# cloud 模式基址（百炼 compatible-mode）
SKIN_CLOUD_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 也可只设环境变量 DASHSCOPE_API_KEY（与本字段二选一，本字段优先）
SKIN_CLOUD_API_KEY=

# ---------- Ollama ----------
SKIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# 多模态视觉模型（本地已就绪：qwen2.5vl:7b / qwen2.5vl:3b / qwen3-vl:2b）
# cloud 模式下若仍写本地名，会自动映射为 qwen-vl-plus / qwen-plus / qwen-turbo
SKIN_VISION_MODEL=qwen2.5vl:7b
# 纯文本生成模型。可复用视觉模型，也可换成更快的纯文本模型（如 qwen2:1.5b）
SKIN_TEXT_MODEL=qwen2.5vl:7b
# 标签抽取 / 重排等轻量任务用的模型，追求速度
SKIN_FAST_MODEL=qwen2.5vl:3b

# ---------- Embedding ----------
# ollama | hf | chroma_default | cloud
#   ollama      -> 用 Ollama 托管的中文向量模型（推荐，需先 ollama pull bge-m3）
#   hf          -> 本地 sentence-transformers（需安装 [hf] extra）
#   chroma_default -> Chroma 内置 ONNX MiniLM（零配置，但中文效果一般，仅建议做冒烟验证）
#   cloud       -> 走云端 /embeddings（默认 text-embedding-v3，需 API Key）
SKIN_EMBEDDING_BACKEND=ollama
SKIN_EMBEDDING_MODEL=bge-m3
# cloud embedding 模型名
SKIN_CLOUD_EMBEDDING_MODEL=text-embedding-v3
# 仅在 backend=hf 时生效
SKIN_EMBEDDING_HF_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 向量库 ----------
SKIN_CHROMA_COLLECTION=skin_kb
# 留空则使用 backend/data/chroma
SKIN_CHROMA_DIR=

# ---------- 分块 ----------
SKIN_CHUNK_SIZE=600
SKIN_CHUNK_OVERLAP=100

# ---------- 检索 ----------
SKIN_RETRIEVAL_TOP_K=8
SKIN_RERANK_TOP_N=4
SKIN_VECTOR_WEIGHT=0.6
SKIN_BM25_WEIGHT=0.4
SKIN_RRF_K=60
# 低于该相关度的命中会被丢弃（0~1）
SKIN_MIN_RELEVANCE=0.15
# LLM 重排：质量更高但本地推理会明显增加延迟，默认关闭
SKIN_RERANK_ENABLED=false

# ---------- 图像 ----------
SKIN_MAX_IMAGE_MB=8
SKIN_IMAGE_MAX_SIDE=1280
SKIN_IMAGE_JPEG_QUALITY=88

# ---------- 会话 ----------
SKIN_SESSION_HISTORY_TURNS=6

# ---------- 超时（秒） ----------
SKIN_LLM_TIMEOUT=180
SKIN_VISION_TIMEOUT=300

# ---------- 持久化 ----------
# 留空则使用 backend/data/app.db
SKIN_SQLITE_PATH=

# ---------- 鉴权与权限 ----------
# 默认 false（匿名即可调用，便于本地开发与跑测试）。
# 置 true 后所有接口都要求登录，客户只能提问与只读查看知识库。
SKIN_AUTH_ENABLED=true
# 是否允许自助注册。注册产生的账号角色固定为 customer，无法提权。
SKIN_AUTH_ALLOW_REGISTRATION=true
# 会话 cookie 的 Secure 属性：本地 http 必须 false，
# 否则浏览器会丢弃 cookie，表现为「登录成功但下一次请求又是未登录」。
# 公网 HTTPS 部署必须改成 true。
SKIN_AUTH_COOKIE_SECURE=false
# 绝对超时（小时）与空闲超时（分钟）：两者取较小者生效
SKIN_AUTH_SESSION_TTL_HOURS=12
SKIN_AUTH_IDLE_TIMEOUT_MINUTES=120
# 连续登录失败 N 次后锁定 M 分钟
SKIN_AUTH_MAX_FAILED_ATTEMPTS=5
SKIN_AUTH_LOCKOUT_MINUTES=15
# 密码最小长度
SKIN_AUTH_MIN_PASSWORD_LENGTH=8
