# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.Python

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 测试与工具缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 密钥与本地配置 ----------
.env
